}

# where the theme you picked gets stashed so it dont reset every run
# one line file. no json. no yaml. no body got time for that
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/splitaudio"
CFG_FILE="$CFG_DIR/theme"

# env var beats the config file, config file beats the default (mocha)
# so you can do SPLITAUDIO_THEME=nord splitaudio without chaning your setup
# also gotta strip any whitespace cuz my theme file has a newline in it
theme_init() {
    local t="${SPLITAUDIO_THEME:-}"
    if [[ -z "$t" && -r "$CFG_FILE" ]]; then
        t=$(<"$CFG_FILE")
    fi
    t="${t//[[:space:]]/}"
    [[ -z "$t" ]] && t="catppuccin-mocha"
    theme_set "$t"
}

# writes the theme file. mkdir -p cuz a fresh arch install aint got the folder
# and i cant be botherd to tell you to make it
theme_save() {
    mkdir -p "$CFG_DIR" 2>/dev/null || return 1
    printf '%s\n' "$THEME" > "$CFG_FILE" || return 1
}

# checks the name actually exists before we write garbage into the config
# i know grep would do this in one line. i dont care, this works
theme_valid() {
    local t
    while IFS= read -r t; do [[ "$t" == "$1" ]] && return 0; done < <(theme_names)
    return 1
}

