# picks the big logo if your terminal is wide enough, the small one if not.
# the cli uses this for --version, --help and every split run, so the logo is
# the same everywhere and not just on the splash screen
logo_print() {
    local sz cols
    # ask the terminal itself first. tput needs a sane TERM and people love
    # running this from somewhere weird, so stty is the safer bet
    sz=$(stty size 2>/dev/null) || sz=""
    cols=${sz##* }
    [[ "$cols" =~ ^[0-9]+$ ]] || cols="${COLUMNS:-80}"
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    # 102 not 100 cuz a line exactly as wide as the terminal wraps, and then the
    # logo looks like it fell down the stairs
    if (( cols >= 102 )); then
        tui_logo_big
    else
        tui_logo
    fi
}

