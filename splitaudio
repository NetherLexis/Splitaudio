# =====================================================================
# the boring path. splitaudio file.mkv and it just gets on with it. no ui, no
# theme, no boxes. this is the one scripts use and the one that still works
# when my terminal is busy doing something else
#
# NEW_FILES collects everything we wrote so the end can print a little list
NEW_FILES=()

# runs one ffmpeg job and sits there reading its progress file so the bar
# actually moves. ffmpeg -progress dumps out_time_us to a temp file every half
# second, we grab the last one and turn it into a percentage. cheap trick but
# it looks propper and thats what matters
run_job() {  # input + out + duration + label + ffmpeg args
    local input="$1" out="$2" total="$3" label="$4"
    shift 4
    local pf err pid rc=0 us
    pf=$(mktemp); err=$(mktemp)

    ffmpeg -hide_banner -loglevel error -nostdin -progress "$pf" -y \
        -i "$input" "$@" "$out" >/dev/null 2>"$err" &
    pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        us=$(sed -n 's/^out_time_us=//p' "$pf" 2>/dev/null | tail -n1)
        [[ "${us:-}" =~ ^[0-9]+$ ]] || us=0
        draw_bar "$(( us / 1000000 ))" "$total" "$label"
        sleep 0.15
    done
    wait "$pid"; rc=$?
    printf '\r\033[K'

    if (( rc != 0 )); then
        warn "ffmpeg choked on $label"
        sed -n '1,4p' "$err" | sed 's/^/    /' >&2
    else
        NEW_FILES+=("$out")
    fi
    rm -f "$pf" "$err"
    return $rc
}

# does one whole file. video first, then every audio track it can dig up
# returns 1 if anything at all went wrong so the end of main can moan about it
process() {
    local input="$1"
    if [[ ! -f "$input" ]]; then
        warn "skipping $input, its not a file"
        return 1
    fi

    local dir path base ext duration acount vcount failed=0
    dir=$(dirname -- "$input")
    path=$(basename -- "$input")
    if [[ "$path" == *.* ]]; then
        base="${path%.*}"
        ext="${path##*.}"
    else
        base="$path"
        ext="mkv"
    fi

    duration=$(ffprobe -v error -show_entries format=duration \
        -of default=nw=1:nk=1 -- "$input" 2>/dev/null)
    duration=${duration%%.*}
    [[ "${duration:-}" =~ ^[0-9]+$ ]] || duration=0

    acount=$(ffprobe -v error -select_streams a -show_entries stream=index \
        -of csv=p=0 -- "$input" 2>/dev/null | grep -c . || true)
    vcount=$(ffprobe_value v:0 stream=index "$input" | head -n1)

    printf '%s%s%s  %s%s%s  |  %s  |  %d audio track(s)\n' \
        "$BOLD" "$path" "$RST" "$SUB" "$(timestr "$duration")" "$RST" \
        "${vcount:+video}" "$acount"

    # step 1 - the video. copied not re-encoded, cuz re-encoding a 40 minute
    # recording on a handheld would take longer than watching it
    if [[ -n "$vcount" ]]; then
        local vout
        vout=$(unique_path "$dir" "${base}_video" "$ext")
        run_job "$input" "$vout" "$duration" "video only" \
            -map 0:v:0 -c:v copy -an || failed=1
    else
        say "  ${SUB}no video stream, nothing to copy${RST}"
    fi

    # step 2 - every audio track on its own. this bit is the whole point of
    # the script, the video copy is just a bonus
    if (( acount == 0 )); then
        say "  ${SUB}no audio tracks found${RST}"
    else
        local p name aout
        for (( p = 0; p < acount; p++ )); do
            name=$(track_name_of "$input" "$p")
            aout=$(unique_path "$dir" "${base}_${name}" mp3)
            run_job "$input" "$aout" "$duration" "audio $p -> $name.mp3" \
                -map "0:a:$p" -q:a 2 || failed=1
        done
    fi

    return $failed
}

# =====================================================================
#                              t u i
# =====================================================================
# =====================================================================
#                            t u i
# =====================================================================
# the fun bit. full screen, boxes, bars, the lot. everything gets drawn into
# one big FRAME string and dumped in a single write at the end, cuz printing it
# line by line flickers like mad on some terminals
#
# H W LW RW BODY are all screen measurements. term_size refills em every frame
# so you can resize the window mid split and it wont fall apart
H=24; W=80; LW=38; RW=39; BODY=18
LINE=0
TTY_SAVED=""
TUI_CURDIR="$PWD"
TUI_PICK=""
FRAME=""
SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# stty cuz tput lied to me once and i never forgave it
# the fallback numbers are for the 1 time in 100 that stty isnt there
term_size() {
    local sz
    sz=$(stty size 2>/dev/null) || sz="24 80"
    H=${sz%% *}
    W=${sz##* }
    [[ "$H" =~ ^[0-9]+$ ]] || H=24
    [[ "$W" =~ ^[0-9]+$ ]] || W=80
    (( H < 14 )) && H=14
    (( W < 60 )) && W=60
}

# works out the pane widths and how many body rows we get. called at the top
# of every single draw so it always matches the window right now
metrics() {
    term_size
    LW=$(( (W - 3) / 2 ))
    RW=$(( W - 3 - LW ))
    BODY=$(( H - 6 ))
    (( BODY < 4 )) && BODY=4
    # pre-baked divider rules. building these every frame was another 5 forks
    strrep '─' $(( W - 2 )) DIV_FULL
    strrep '─' "$LW" DIV_L
    strrep '─' "$RW" DIV_R
}

# puts the cursor back and kills any leftover colours. if the script dies with
# the cursor hidden you get to play hide and seek with your own mouse pointer
# puts the cursor back, turns autowrap back on, closes any half finished sync
# update and kills leftover colours. if this dont run your terminal stays
# in a weird state and you get to reboot your shell
tui_restore() {
    printf '\033[?2026l\033[?7h\033[?25h\033[0m'
    # put the terminal back exactly how we found it. without this, if you smash
    # keys during the splash they get echoed into the middle of the frame and
    # you sit there wondering why theres a stray "q" on your border
    [[ -n "$TTY_SAVED" ]] && stty "$TTY_SAVED" 2>/dev/null
    TTY_SAVED=""
}

# arrows come in as esc [ A B C D, so after the esc we peek at 2 more chars.
# if none of em look like an arrow its a plain esc press. good enough, and if
# you mash keys hard enough to confuse it then honestly thats on you
read_key() {
    local rest
    KEY=""
    IFS= read -rsn1 key
    if [[ "$key" == $'\e' ]]; then
        IFS= read -rsn2 -t 0.05 rest || rest=""
        case "$rest" in
            '[A') KEY="UP" ;;
            '[B') KEY="DOWN" ;;
            '[C') KEY="RIGHT" ;;
            '[D') KEY="LEFT" ;;
            *)    KEY="ESC" ;;
        esac
    else
        case "$key" in
            "")            KEY="ENTER" ;;
            $'\x7f'|$'\b') KEY="BACK" ;;
            *)             KEY="$key" ;;
        esac
    fi
}

# ---------- frame primitives ----------
# tiny helpers for building the screen. fl() pushes one line onto FRAME and
# sticks the background colour on the front so a themed bg dont break halfway
# down the screen. everything else here is just box drawing
# pushes one line onto FRAME at an absolute position instead of relying on
# newlines. sounds overkill but its not: every line here is exactly as wide as
# the terminal, so a newline after a full width line makes some terminals do a
# extra linefeed and the whole frame ends up 60 rows tall in a 30 row window.
# absolute row/col means the wrapping can never happen at all. lessons were learnt
fl() {
    local n=$(( LINE + 1 ))
    printf -v line_esc '\033[%d;1H' "$n"
    FRAME+="$line_esc${BG}$1"
    LINE=$n
}
# a row of dashes. riviting stuff, i know
hline() { strrep '─' "$1" __h; printf '%s' "$__h"; }

# the top border. title on the left, my name on the right, because i built
# the thing and im taking the credit
# if the window is tiny it drops my name instead of breaking the border
tui_top() {
    local left=" splitaudio $VERSION " right=" by $AUTHOR " n fill
    n=$(( W - 4 - ${#left} - ${#right} ))
    if (( n < 1 )); then
        strrep '─' $(( W - 3 - ${#left} )) fill
        fl "${M}┌─${RST}${BOLD}${C}${left}${RST}${M}${fill}┐${RST}"
        return
    fi
    strrep '─' "$n" fill
    fl "${M}┌─${RST}${BOLD}${B}${left}${RST}${M}${fill}${RST}${C}${right}${RST}${M}─┐${RST}"
}

tui_bottom() {
    fl "${M}└${DIV_FULL}┘${RST}"
}

tui_div() { fl "${M}├${DIV_FULL}┤${RST}"; }
tui_div_top() { fl "${M}├${DIV_L}┬${DIV_R}┤${RST}"; }
tui_div_bottom() { fl "${M}├${DIV_L}┴${DIV_R}┤${RST}"; }

tui_row() {  # text [style]
    local t="$1" st="${2:-$TX}" inner
    fitv "$t" $(( W - 2 )) inner
    fl "${M}│${RST}${st}${inner}${RST}${M}│${RST}"
}

tui_split() {  # left right [style]
    local l="$1" r="$2" st="${3:-$TX}" li ri
    fitv "$l" "$LW" li
    fitv "$r" "$RW" ri
    fl "${M}│${RST}${st}${li}${RST}${M}│${RST}${st}${ri}${RST}${M}│${RST}"
}

# the key hints on the left and my name on the right, sitting on the coloured
# footer bar. this is the only row that gets a background block in every screen
tui_footer() {  # hint text
    local l=" $1 " r=" $AUTHOR " n pad
    n=$(( W - 2 - ${#l} - ${#r} ))
    (( n < 0 )) && { r=""; n=$(( W - 2 - ${#l} )); }
    strrep ' ' "$n" pad
    fl "${M}│${RST}${BAR}${DIM}${l}${pad}${RST}${BAR}${C}${r}${RST}${M}│${RST}"
}

# dumps the whole frame in one go. cursor goes home first, then the frame, then
# a reset so we dont leak colours into your shell afterwards
# dumps the whole frame in one go. cursor goes home first, then the frame, then
# a reset so we dont leak colours into your shell afterwards
#
# the ?2026 bit is a syncronised update: the terminal holds everything back
# until the closing one, so you get the whole frame at once instead of watching
# it paint itself line by line. without it the animations flicker like mad
tui_flush() {
    printf '\033[?2026h%s\033[?2026l\033[0m' "$FRAME"
    FRAME=""
    LINE=0
}

# ---------- file browser ----------
# only folders and video files show up here. i aint listing 4000 random mp3s,
# you know what you came here for
ITEM_KIND=(); ITEM_PATH=(); ITEM_LABEL=(); ITEM_SIZE=()
DET=(); DET_KEY=""
FLASH=0   # frames left of the selection highlight, see the movement handling

# builds the item lists fresh every time you change folder. ../ is always
# first so you can never get stuck in a folder with nothing in it
tui_list() {
    local d="$1" e ext
    ITEM_KIND=(); ITEM_PATH=(); ITEM_LABEL=(); ITEM_SIZE=()
    ITEM_KIND+=("up"); ITEM_PATH+=("$d"); ITEM_LABEL+=("../"); ITEM_SIZE+=("")

    for e in "$d"/*/; do
        [[ -d "$e" ]] || continue
        e="${e%/}"
        ITEM_KIND+=("dir")
        ITEM_PATH+=("$e")
        ITEM_LABEL+=("${e##*/}/")
        ITEM_SIZE+=("")
    done

    # collect the videos first, then get all the sizes in ONE du call. the old
    # version forked a du per file, so a folder with 300 recordings took about a
    # second just to list. basename gets done with ${var##*/} for the same reason
    local -a files=()
    for e in "$d"/*; do
        [[ -f "$e" ]] || continue
        [[ "${e,,}" == *.* ]] || continue
        ext="${e##*.}"
        [[ " mp4 mkv mov webm m4v avi ts flv wmv mpg mpeg vob ogv " == *" ${ext,,} "* ]] || continue
        files+=("$e")
    done

    local -a sizes=()
    if (( ${#files[@]} > 0 )); then
        mapfile -t sizes < <(du -h --apparent-size -- "${files[@]}" 2>/dev/null | cut -f1)
    fi
    local i
    for i in "${!files[@]}"; do
        ITEM_KIND+=("file")
        ITEM_PATH+=("${files[i]}")
        ITEM_LABEL+=("${files[i]##*/}")
        ITEM_SIZE+=("${sizes[i]:-}")
    done
}

# the right pane. probes whatever is selected and shows what we found.
# caches by path so holding the down arrow dont run ffprobe 60 times a second
tui_details() {  # path + kind
    local p="$1" k="$2" key="$2:$1" sz i ext rule
    [[ "$key" == "$DET_KEY" ]] && return
    DET_KEY="$key"
    DET=()

    case "$k" in
        up)  DET+=("" "  go up a level" "" "  made by $AUTHOR"); return ;;
        dir) DET+=("" "  folder" "" "  hit enter to open it"); return ;;
    esac

    ext="${p##*.}"
    sz=$(du -h --apparent-size -- "$p" 2>/dev/null | cut -f1)
    probe_all "$p"

    DET+=("  ${p##*/}")
    strrep '─' $(( ${#DET[0]} - 2 )) rule
    DET+=("  $rule")
    DET+=("")
    DET+=("  duration   $(timestr "$R_DUR")")
    DET+=("  size       ${sz:-?}")
    DET+=("  container  ${ext}")
    DET+=("  video      ${R_VCODEC:-none}")
    DET+=("")
    DET+=("  audio tracks  $R_ACOUNT")
    for (( i = 0; i < R_ACOUNT; i++ )); do
        DET+=("    $i  ${R_NAME[i]}   ${R_CODEC[i]:-?} ${R_CH[i]:-?}ch")
    done
    DET+=("")
    DET+=("  will write")
    DET+=("    ${TUI_BASE}_video.${ext}")
    for (( i = 0; i < R_ACOUNT; i++ )); do
        DET+=("    ${TUI_BASE}_${R_NAME[i]}.mp3")
    done
    DET+=("")
    DET+=("  v$VERSION by $AUTHOR")
}

tui_browser() {
    local sel=0 top=0 i rows max namecol gcol label size seg segsel
    local nlab leftpad leftsel detrow
    TUI_PICK=""
    tui_list "$TUI_CURDIR"

    while :; do
        metrics
        rows=$BODY
        max=$(( ${#ITEM_PATH[@]} - 1 ))
        (( sel > max )) && sel=$max
        (( sel < 0 )) && sel=0
        (( sel < top )) && top=$sel
        (( sel >= top + rows )) && top=$(( sel - rows + 1 ))

        TUI_BASE="${ITEM_PATH[sel]##*/}"
        [[ "${ITEM_PATH[sel]}" == *.* ]] && TUI_BASE="${TUI_BASE%.*}"
        tui_details "${ITEM_PATH[sel]}" "${ITEM_KIND[sel]}"

        FRAME=$'\033[H'
        tui_top
        tui_row "  $TUI_CURDIR" "$DIM"
        tui_div_top

        # 2 for the marker and space, 1 for the gap, 7 for the size column
        # get this maths wrong by one and the selected row leaves a stale
        # character in the last column. ask me how i know
        namecol=$(( LW - 11 ))
        (( namecol < 8 )) && namecol=8
        for (( i = top; i < top + rows; i++ )); do
            if (( i > max )); then
                tui_split "" "${DET[i - top]:-}"
                continue
            fi
            label="${ITEM_LABEL[i]}"
            printf -v size '%7s' "${ITEM_SIZE[i]}"
            case "${ITEM_KIND[i]}" in
                dir) gcol="$C" ;;
                up)  gcol="$MUT" ;;
                *)   gcol="$TX" ;;
            esac
            # all the padding is done with fitv so a row costs 0 forks
            fitv "$label" "$namecol" nlab
            seg="  $nlab $size"
            segsel="▌ $nlab $size"
            fitv "$seg" "$LW" leftpad
            fitv "$segsel" "$LW" leftsel
            fitv "${DET[i - top]:-}" "$RW" detrow
            if (( i == sel )); then
                # flash frame: the whole row goes solid accent with the base
                # colour text for one frame when you land on it
                if (( FLASH > 0 )) && [[ -n "$ACCBG" ]]; then
                    fl "${M}│${RST}${ACCBG}${BASEFG}${BOLD}${leftsel}${RST}${M}│${RST}${TX}${detrow}${RST}${M}│${RST}"
                else
                    fl "${M}│${RST}${SEL}${leftsel}${RST}${M}│${RST}${TX}${detrow}${RST}${M}│${RST}"
                fi
            else
                fl "${M}│${RST}${gcol}${leftpad}${RST}${M}│${RST}${TX}${detrow}${RST}${M}│${RST}"
            fi
        done

        tui_div_bottom
        if [[ ${#ITEM_PATH[@]} -le 1 ]]; then
            tui_footer "nothing to split in here. go find a video"
        else
            tui_footer "↑↓ move   ⏎ open / split   ⌫ up a folder   t themes   q quit"
        fi
        tui_bottom
        tui_flush

        # the selection flash. one extra frame where the row you just landed on
        # is solid accent, then the normal frame. 50ms so it dont feel laggy but
        # you can still see it. this is the animation while going through files
        if (( FLASH > 0 )); then
            FLASH=$(( FLASH - 1 ))
            sleep 0.05
            continue
        fi

        read_key
        case "$KEY" in
            UP|k)   (( sel > 0 )) && { (( sel-- )); FLASH=1; } ;;
            DOWN|j) (( sel < max )) && { (( sel++ )); FLASH=1; } ;;
            t|T)    tui_theme_picker; TUI_BASE=""; DET_KEY="" ;;
            BACK|LEFT|h)
                if [[ "$TUI_CURDIR" != "/" ]]; then
                    TUI_CURDIR=$(dirname -- "$TUI_CURDIR")
                    tui_list "$TUI_CURDIR"
                    sel=0; top=0; DET_KEY=""
                fi
                ;;
            ENTER|RIGHT|l)
                case "${ITEM_KIND[sel]}" in
                    up)
                        [[ "$TUI_CURDIR" != "/" ]] && TUI_CURDIR=$(dirname -- "$TUI_CURDIR")
                        sel=0; top=0; tui_list "$TUI_CURDIR"; DET_KEY=""
                        ;;
                    dir)
                        TUI_CURDIR="${ITEM_PATH[sel]}"
                        sel=0; top=0; tui_list "$TUI_CURDIR"; DET_KEY=""
                        ;;
                    file)
                        TUI_PICK="${ITEM_PATH[sel]}"
                        return 0
                        ;;
                esac
                ;;
            q|Q) return 1 ;;
        esac
    done
}

# ---------- plan ----------
# works out every output filename BEFORE anything actually runs, so the review
# screen can show you exactly what is about to land on your disk. no surprises
P_DIR=""; P_PATH=""; P_BASE=""; P_EXT=""; P_DUR=0; P_ACOUNT=0
P_VIDEO=""; P_VCODEC=""; P_A_NAMES=(); P_A_CODEC=(); P_A_CH=(); P_A_OUT=()
P_VOUT=""

# the proper probe, not the quick one from the details pane. duration, video
# codec, every audio track with its codec and channel count
tui_plan() {
    local input="$1" p
    P_PATH="$input"
    P_DIR=$(dirname -- "$input")
    P_BASE=$(basename -- "$input")
    if [[ "$P_BASE" == *.* ]]; then
        P_EXT="${P_BASE##*.}"
        P_BASE="${P_BASE%.*}"
    else
        P_EXT="mkv"
    fi

    P_DUR=$(ffprobe -v error -show_entries format=duration \
        -of default=nw=1:nk=1 -- "$input" 2>/dev/null)
    P_DUR=${P_DUR%%.*}
    [[ "${P_DUR:-}" =~ ^[0-9]+$ ]] || P_DUR=0

    P_ACOUNT=$(ffprobe -v error -select_streams a -show_entries stream=index \
        -of csv=p=0 -- "$input" 2>/dev/null | grep -c . || true)

    P_VIDEO=$(ffprobe_value v:0 stream=index "$input" | head -n1)
    P_VCODEC=$(ffprobe_value v:0 stream=codec_name "$input" | head -n1)

    P_A_NAMES=(); P_A_CODEC=(); P_A_CH=(); P_A_OUT=()
    for (( p = 0; p < P_ACOUNT; p++ )); do
        P_A_NAMES+=("$(track_name_of "$input" "$p")")
        P_A_CODEC+=("$(ffprobe_value "a:$p" stream=codec_name "$input" | head -n1)")
        P_A_CH+=("$(ffprobe_value "a:$p" stream=channels "$input" | head -n1)")
        P_A_OUT+=("$(unique_path "$P_DIR" "${P_BASE}_${P_A_NAMES[p]}" mp3)")
    done
    P_VOUT=$(unique_path "$P_DIR" "${P_BASE}_video" "$P_EXT")
}

# the review screen. last chance to back out before it starts writing things
# into your folder. i learnt to put this in after i split the wrong recording
# 3 times in a row
tui_confirm() {
    local i rows lines=()
    lines+=("  ${P_BASE}.${P_EXT}")
    lines+=("  $(hline $(( ${#lines[0]} - 2 )))")
    lines+=("")
    lines+=("  duration  $(timestr "$P_DUR")")
    lines+=("  video     ${P_VCODEC:-none}")
    lines+=("  audio     $P_ACOUNT track(s)")
    lines+=("")
    lines+=("  about to write")
    lines+=("    $(basename -- "$P_VOUT")")
    for (( i = 0; i < P_ACOUNT; i++ )); do
        lines+=("    $(basename -- "${P_A_OUT[i]}")")
    done

    while :; do
        metrics
        rows=$BODY
        FRAME=$'\033[H'
        tui_top
        tui_row "  check it before i eat your disk" "$DIM"
        tui_div
        if (( ${#lines[@]} > rows )); then
            for (( i = 0; i < rows; i++ )); do tui_row "${lines[i]}"; done
        else
            for (( i = 0; i < ${#lines[@]}; i++ )); do
                case "${lines[i]}" in
                    *"about to write"*) tui_row "${lines[i]}" "$BOLD$C" ;;
                    "    "*)            tui_row "${lines[i]}" "$G" ;;
                    *)                  tui_row "${lines[i]}" ;;
                esac
            done
            for (( i = ${#lines[@]}; i < rows; i++ )); do tui_row ""; done
        fi
        tui_div
        tui_footer "⏎ send it    ⌫ pick something else    t themes    q quit"
        tui_bottom
        tui_flush

        read_key
        case "$KEY" in
            ENTER) return 0 ;;
            t|T)   tui_theme_picker ;;
            BACK|ESC|LEFT) return 1 ;;
            q|Q) return 2 ;;
        esac
    done
}

# ---------- running ----------
# the job list. each job goes pending -> running -> done, and theres a little
# braille spinner going so it dont look frozen while ffmpeg thinks about life
JOBS_LABEL=(); JOBS_OUT=(); JOBS_STATUS=(); JOBS_SIZE=()
JOBS_MAP=(); JOBS_APOS=()
RUN_DONE=0; RUN_FAIL=0
ANIM=0
DISP=0

# video job first if there is one, then one job per audio track. the order
# here is the order they run in, so the big copy finishes first and the quick
# audio jobs fill the rest of the time
tui_build_jobs() {
    local i
    JOBS_LABEL=(); JOBS_OUT=(); JOBS_STATUS=(); JOBS_SIZE=()
    JOBS_MAP=(); JOBS_APOS=()
    RUN_DONE=0; RUN_FAIL=0
    if [[ -n "$P_VIDEO" ]]; then
        JOBS_LABEL+=("$(basename -- "$P_VOUT")")
        JOBS_OUT+=("$P_VOUT")
        JOBS_STATUS+=("pending")
        JOBS_SIZE+=("")
        JOBS_MAP+=("video")
        JOBS_APOS+=("0")
    fi
    for (( i = 0; i < P_ACOUNT; i++ )); do
        JOBS_LABEL+=("$(basename -- "${P_A_OUT[i]}")")
        JOBS_OUT+=("${P_A_OUT[i]}")
        JOBS_STATUS+=("pending")
        JOBS_SIZE+=("")
        JOBS_MAP+=("audio")
        JOBS_APOS+=("$i")
    done
}

# redraws the whole running screen for the current percent. yes its the whole
# screen every 0.1s. no its not slow, the screen is like 2kb of text
tui_run_paint() {  # current percent
    local pct="$1" rows i total=${#JOBS_OUT[@]}
    local overall=0 done_n=0 st line spin
    metrics

    # ffmpeg only tells us the progress like twice a second, which makes the bar
    # jump in ugly chunks. so the bar we DRAW chases the real number a quarter
    # of the gap at a time. looks smooth, costs nothing, and its not lying
    # enough for anyone to notice
    if (( pct > DISP )); then
        DISP=$(( DISP + (pct - DISP + 3) / 4 ))
        (( DISP > pct )) && DISP=$pct
    else
        DISP=$pct
    fi

    for (( i = 0; i < total; i++ )); do
        [[ "${JOBS_STATUS[i]}" == "done" ]] && (( done_n++ ))
    done
    if (( total > 0 )); then
        overall=$(( (done_n * 100 + (DISP > 0 ? DISP : 0)) / total ))
    fi
    (( overall > 100 )) && overall=100
    spin="${SPIN[ANIM % ${#SPIN[@]}]}"

    FRAME=$'\033[H'
    tui_top
    tui_row "  $P_BASE.$P_EXT   ·  $(timestr "$P_DUR")  ·  $total job(s)" "$BOLD$B"
    tui_div
    barv "$overall" $(( W - 14 )) obar
    tui_row "  $obar  ${overall}%" "$B"
    tui_row ""

    rows=$BODY
    for (( i = 0; i < total && i + 2 < rows; i++ )); do
        st="${JOBS_STATUS[i]}"
        case "$st" in
            done)
                fitv "${JOBS_LABEL[i]}" $(( W - 16 )) jlab
                printf -v jsize '%7s' "${JOBS_SIZE[i]}"
                tui_row "  ✓ $jlab $jsize" "$G"
                ;;
            fail)
                tui_row "  ✗ ${JOBS_LABEL[i]}  failed" "$R"
                ;;
            running)
                fitv "${JOBS_LABEL[i]}" $(( W - 40 )) jlab
                barv "$DISP" 20 jbar
                line="  $spin $jlab  $jbar  ${DISP}%"
                tui_row "$line" "$Y"
                ;;
            *)
                tui_row "  · ${JOBS_LABEL[i]}" "$MUT"
                ;;
        esac
    done
    for (( i = total + 2; i < rows; i++ )); do tui_row ""; done

    tui_div
            tui_footer "$spin splitting. dont close this"
    tui_bottom
    tui_flush
}

# the actual loop. one ffmpeg at a time cuz this machine isnt a supercomputer
# and running 4 of em at once on a handheld just makes everything slower
tui_run() {
    local i pf err pid rc us dur=$P_DUR
    ANIM=0
    tui_run_paint 0

    for (( i = 0; i < ${#JOBS_OUT[@]}; i++ )); do
        JOBS_STATUS[i]="running"
        DISP=0   # every job starts its own bar from zero
        pf=$(mktemp); err=$(mktemp)
        if [[ "${JOBS_MAP[i]}" == "video" ]]; then
            ffmpeg -hide_banner -loglevel error -nostdin -progress "$pf" -y \
                -i "$P_PATH" -map 0:v:0 -c:v copy -an "${JOBS_OUT[i]}" \
                >/dev/null 2>"$err" &
        else
            ffmpeg -hide_banner -loglevel error -nostdin -progress "$pf" -y \
                -i "$P_PATH" -map "0:a:${JOBS_APOS[i]}" -q:a 2 "${JOBS_OUT[i]}" \
                >/dev/null 2>"$err" &
        fi
        pid=$!

        while kill -0 "$pid" 2>/dev/null; do
            us=$(sed -n 's/^out_time_us=//p' "$pf" 2>/dev/null | tail -n1)
            [[ "${us:-}" =~ ^[0-9]+$ ]] || us=0
            (( ANIM++ ))
            if (( dur > 0 )); then
                tui_run_paint $(( us / 10000 / dur ))
            else
                tui_run_paint 0
            fi
            sleep 0.08   # smooth enough without melting the cpu
        done
        wait "$pid"; rc=$?

        if (( rc == 0 )); then
            JOBS_STATUS[i]="done"
            JOBS_SIZE[i]="$(du -h --apparent-size -- "${JOBS_OUT[i]}" 2>/dev/null | cut -f1)"
            (( RUN_DONE++ ))
        else
            JOBS_STATUS[i]="fail"
            (( RUN_FAIL++ ))
        fi
        rm -f "$pf" "$err"
        tui_run_paint 100
    done
}

# results screen. the files pop in one at a time cuz it looks nicer than all of
# em slapping down at once. thats the animation. yes i could make it fancier.
# no im not going to
tui_done() {
    local i rows total=${#JOBS_OUT[@]} head reveal=0

    if (( RUN_FAIL > 0 )); then
        head="  $RUN_DONE written, $RUN_FAIL failed. whatever"
    else
        head="  done. $RUN_DONE file(s) written"
    fi

    while :; do
        metrics
        rows=$(( BODY - 1 ))
        FRAME=$'\033[H'
        tui_top
        if (( RUN_FAIL > 0 )); then
            tui_row "$head" "$Y$BOLD"
        else
            tui_row "$head" "$G$BOLD"
        fi
        tui_row "  $P_DIR" "$DIM"
        tui_div
        for (( i = 0; i < total && i < rows; i++ )); do
            if (( i >= reveal )); then
                tui_row ""
            elif [[ "${JOBS_STATUS[i]}" == "done" ]]; then
                fitv "${JOBS_OUT[i]##*/}" $(( W - 16 )) jlab
                printf -v jsize '%7s' "${JOBS_SIZE[i]}"
                tui_row "  ✓ $jlab $jsize" "$G"
            else
                tui_row "  ✗ ${JOBS_OUT[i]##*/}" "$R"
            fi
        done
        for (( i = total; i < rows; i++ )); do tui_row ""; done
        tui_div
        tui_footer "any key takes you back   t themes   q quit"
        tui_bottom
        tui_flush

        # the pop in. 0.16s a row so you actually SEE it happening, cuz the
        # old 0.06 version finished before your eyes finished opening
        if (( reveal < total )); then
            reveal=$(( reveal + 1 ))
            sleep 0.16
            continue
        fi

        read_key
        case "$KEY" in
            t|T) tui_theme_picker; reveal=$total ;;
            q|Q) return 1 ;;
            *)   return 0 ;;
        esac
    done
}

# the little colour words in the picker preview. SWATCH_LEN has to be the
# plain length or the border ends up in the wrong place again. yes its
# hardcoded. yes i counted it twice. dont touch it
swatch_colors() {  # sets SWATCH and SWATCH_LEN
    SWATCH="${TX}text${RST} ${B}accent${RST} ${G}ok${RST} ${Y}warn${RST} ${R}err${RST}${TX}"
    SWATCH_LEN=23
}

# ---------- theme picker ----------
# full screen list with a live preview on the right. picking a theme just sets
# the globals and redraws, so you see it before you commit to it. no saving
# until you hit enter, so you can window shop without breaking your setup
# start on whatever theme you already use so the picker opens where you left off
tui_theme_picker() {
    local list=() desc=() i sel=0 rows start="$THEME" base
    local left="" right="" style="" swatch=0 lfit rfit pad bar45 bar66
    PICK_MSG=""
    mapfile -t list < <(theme_names)
    # the descriptions get cached ONCE. the old version forked a subshell per row
    # per redraw just to ask what a theme is, which is mental when you consider
    # the list dont even change
    for i in "${!list[@]}"; do
        desc[i]="$(theme_desc "${list[i]}")"
    done
    for i in "${!list[@]}"; do
        [[ "${list[i]}" == "$THEME" ]] && sel=$i
    done
    barv 45 8 bar45
    barv 66 30 bar66
    base=${#list[@]}

    while :; do
        theme_set "${list[sel]}"
        metrics
        rows=$BODY
        FRAME=$'\033[H'
        tui_top
        if [[ -n "$PICK_MSG" ]]; then
            tui_row "  $PICK_MSG" "$R"
        else
            tui_row "  pick a theme. my taste is law apparently" "$DIM"
        fi
        tui_div_top

        for (( i = 0; i < rows; i++ )); do
            left=""; right=""; style="$TX"; swatch=0
            if (( i < base )); then
                if (( i == sel )); then left="▌ ${list[i]}"; style="$B"; else left="  ${list[i]}"; fi
                right="  ${desc[i]}"
            else
                case $(( i - base )) in
                    2) right="  preview" ;;
                    3) right="   ✓ ${P_BASE:-rec}_video.mp4   3.6M" ;;
                    4) right="   ▶ desktop_audio.mp3   $bar45  45%" ;;
                    5) right="   · microphone.mp3" ;;
                    6) right="   $bar66  66%" ;;
                    7) swatch=1 ;;
                    8) right="   by $AUTHOR · v$VERSION" ;;
                esac
            fi
            if (( swatch )); then
                swatch_colors
                fitv "" "$LW" lfit
                strrep ' ' $(( RW - 3 - SWATCH_LEN )) pad
                fl "${M}│${RST}${lfit}${M}│${RST}   ${SWATCH}${TX}${pad}${M}│${RST}"
            else
                fitv "$left" "$LW" lfit
                fitv "$right" "$RW" rfit
                if (( i == sel )); then
                    fl "${M}│${RST}${SEL}${B}${lfit}${RST}${M}│${RST}${SEL}${TX}${rfit}${RST}${M}│${RST}"
                else
                    fl "${M}│${RST}${style}${lfit}${RST}${M}│${RST}${TX}${rfit}${RST}${M}│${RST}"
                fi
            fi
        done

        tui_div_bottom
        tui_footer "↑↓ try em on   ⏎ keep it   q bail, back to $start"
        tui_bottom
        tui_flush

        read_key
        case "$KEY" in
            UP|k)   (( sel > 0 )) && (( sel-- )) ;;
            DOWN|j) (( sel < ${#list[@]} - 1 )) && (( sel++ )) ;;
            ENTER)
                theme_set "${list[sel]}"
                if theme_save; then
                    return 0
                fi
                PICK_MSG="cant save in $CFG_DIR"
                ;;
            q|Q|ESC|BACK)
                theme_set "$start"
                return 1
                ;;
        esac
    done
}

