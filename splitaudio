tui_intro() {
    [[ -n "${SPLITAUDIO_NO_ANIM:-}" ]] && return 0

    local art=() i k n body blank lp pad msg maxw=0
    metrics
    mapfile -t art < <(tui_logo_big)
    for lp in "${art[@]}"; do (( ${#lp} > maxw )) && maxw=${#lp}; done
    if (( maxw > W - 4 )); then
        mapfile -t art < <(tui_logo)
    fi

    for n in 0 1 2 3; do
        metrics
        FRAME=$'\033[H'
        tui_top
        body=$(( H - 2 ))
        blank=$(( (body - ${#art[@]} - 4) / 2 ))
        (( blank < 0 )) && blank=0
        for (( i = 0; i < body; i++ )); do
            k=$(( i - blank ))
            if (( k < 0 || k > ${#art[@]} + 3 )); then
                tui_row ""
            elif (( k < ${#art[@]} )); then
                lp="${art[k]}"
                pad=$(( (W - 2 - ${#lp}) / 2 ))
                (( pad < 0 )) && pad=0
                strrep ' ' "$pad" pad
                tui_row "${pad}${lp}" "$B$BOLD"
            elif (( k == ${#art[@]} + 2 )); then
                msg="v$VERSION by $AUTHOR   ·   ${SPIN[n % ${#SPIN[@]}]}  starting up"
                pad=$(( (W - 2 - ${#msg}) / 2 ))
                (( pad < 0 )) && pad=0
                strrep ' ' "$pad" pad
                tui_row "${pad}${msg}" "$SUB"
            else
                tui_row ""
            fi
        done
        tui_bottom
        tui_flush
        sleep 0.12
    done
}

# the main loop: browser -> review -> run -> results -> back to the browser.
# pressing q at any point bounces you out cleanly
# ffmpeg check happens before we hide the cursor, otherwise a missing ffmpeg
# would leave your terminal in a weird state and thats just rude
tui_main() {
    local st=0
    command -v ffmpeg  >/dev/null 2>&1 || die "ffmpeg is missing. pacman -S ffmpeg"
    command -v ffprobe >/dev/null 2>&1 || die "ffprobe is missing. pacman -S ffmpeg"

    TUI_CURDIR=$(cd -- "$TUI_CURDIR" 2>/dev/null && pwd || printf '%s' "$HOME")

    # remember the terminal settings and turn echo off for the whole session.
    # every keypress gets read by read -s anyway, this just stops the ones you
    # type during the splash from showing up as garbage on the screen
    TTY_SAVED=$(stty -g 2>/dev/null) || TTY_SAVED=""
    [[ -n "$TTY_SAVED" ]] && stty -echo 2>/dev/null

    trap 'tui_restore' EXIT
    # hide the cursor, kill autowrap, wipe the screen
    #
    # the autowrap bit is the important one. every line we draw is exactly as
    # wide as the terminal, so with autowrap ON the terminal wraps the last
    # character onto a new row, every line eats 2 rows, the frame ends up twice
    # as tall as your window and the whole screen scrolls 30 lines on every
    # redraw. that was the "jittery whole screen" bug. 0/10 do not recomend
    printf '\033[?25l\033[?7l\033[2J'

    tui_intro

    while :; do
        tui_browser || { break; }
        tui_plan "$TUI_PICK"
        tui_confirm
        case $? in
            0) ;;
            1) continue ;;
            *) break ;;
        esac
        tui_build_jobs
        tui_run
        tui_done || break
    done

    tui_restore
    trap - EXIT
    printf '\033[H\033[2J'
    return "$st"
}

# =====================================================================
#                            e n t r y
# =====================================================================
# =====================================================================
#                            e n t r y
# =====================================================================
# works out which mode you wanted:
#   no args + a real terminal -> full tui
#   no args + piped           -> help text, cuz drawing boxes into a pipe
#                                is a waste of everyones time
#   a filename                -> just split the thing
#   theme [name]              -> theme stuff
main() {
    # theme first so even --version comes out in the right colours
    theme_init

    case "${1:-}" in
        "")
            if [[ -t 0 && -t 1 ]]; then
                tui_main
                exit $?
            fi
            usage; exit 0
            ;;
        -h|--help|help) usage; exit 0 ;;
        -v|--version)
            # full banner now, not one sad line
            banner
            printf '%s   made by %s. dont sell it%s\n' "$DIM" "$AUTHOR" "$RST"
            exit 0
            ;;
        theme)
            shift
            # with a name it just sets it, no picker, so dotfiles and scripts can
            # call it without a terminal
            if [[ $# -gt 0 ]]; then
                theme_valid "$1" || die "no theme called $1. pick one of: $(theme_names | tr '\n' ' ')"
                theme_set "$1"
                theme_save || die "cant write $CFG_FILE"
                say "theme is now ${B}${THEME}${RST}. nice choice"
                exit 0
            fi
            # no terminal? then print the list instead of trying to draw a
            # picker into a pipe. past me would of just crashed here
            if [[ -t 0 && -t 1 ]]; then
                tui_theme_picker
                tui_restore
                printf '\033[H\033[2J'
                exit 0
            fi
            say "youre on $THEME right now"
            while IFS= read -r t; do
                if [[ "$t" == "$THEME" ]]; then
                    say "  ${G}*${RST} $t  ${SUB}$(theme_desc "$t")${RST}"
                else
                    say "    $t  ${SUB}$(theme_desc "$t")${RST}"
                fi
            done < <(theme_names)
            exit 0
            ;;
        tui)
            [[ -t 0 && -t 1 ]] || die "the tui needs a real terminal"
            tui_main
            exit $?
            ;;
    esac

    # plain text mode for the cli. theme colours stay, the big background block
    # goes away cuz it would cover your wallpaper and look daft
    theme_cli
    command -v ffmpeg  >/dev/null 2>&1 || die "ffmpeg is missing. pacman -S ffmpeg"
    command -v ffprobe >/dev/null 2>&1 || die "ffprobe is missing. pacman -S ffmpeg"

    banner

    local f ok=0 bad=0
    for f in "$@"; do
        [[ "$f" == "--" ]] && continue
        if process "$f"; then
            (( ok++ ))
        else
            (( bad++ ))
        fi
        printf '\n'
    done

    if (( ${#NEW_FILES[@]} > 0 )); then
        printf '%sdone%s - %d file(s) written\n' "$G$BOLD" "$RST" "${#NEW_FILES[@]}"
        for f in "${NEW_FILES[@]}"; do
            printf '  %s%6s%s  %s\n' "$SUB" "$(du -h -- "$f" | cut -f1)" "$RST" "$f"
        done
    fi

    if (( bad > 0 )); then
        warn "$bad file(s) didnt go through"
        exit 1
    fi
}

# right. off we go
