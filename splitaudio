#!/usr/bin/env bash
# splitaudio - yanks the video out and every seperate audio track with it
# made by NLexis. yes that NLexis. the Nether_ guy. same idiot
# needs ffmpeg or this whole thing is a brick
#
# how it works: copy the video stream straight across (no re-encode, im not
# waiting around for that), then re-encode every audio track into its own mp3.
# obs hands you like 5 tracks if you look at it wrong and doing that by hand
# every single time was slowly killing me
#
# had this as a .bat once. hardcoded someone elses desktop path. never again

set -uo pipefail

VERSION="1.5"
AUTHOR="NLexis"

# =====================================================================
#                          c o l o u r s
# =====================================================================
# if the terminal says it does 24 bit colour, belive it. if it dont, we crunch
# the hexes down to 256 colours later and nobody can tell the differance
TRUECOLOR=0
case "${COLORTERM:-}" in *truecolor*|*24bit*) TRUECOLOR=1 ;; esac
# if your piping this into a file or you set NO_COLOR then we shut up and
# print plain text. respectfull like that
COLOR_OK=0
[[ -t 1 && -z "${NO_COLOR:-}" ]] && COLOR_OK=1

# #aabbcc -> 3 little numbers. wild stuff i know
hex_rgb() {
    local h="${1#\#}"
    printf '%d %d %d' $(( 16#${h:0:2} )) $(( 16#${h:2:2} )) $(( 16#${h:4:2} ))
}

# crunches a hex down to the closest xterm 256 colour. the greys are a whole
# seperate thing cuz they live on their own little ramp at the end of the palette
hex256() {
    local r g b
    read -r r g b <<< "$(hex_rgb "$1")"
    if (( r == g && g == b )); then
        if (( r < 8 )); then printf 16
        elif (( r > 248 )); then printf 231
        else printf '%d' $(( 232 + (r - 8) / 10 )); fi
        return
    fi
    printf '%d' $(( 16 + 36 * ((r * 5 + 127) / 255) + 6 * ((g * 5 + 127) / 255) + ((b * 5 + 127) / 255) ))
}

# builds a foreground escape. gives you an empty string if colours are off so
# the rest of the script dont have to care
setfg() {
    local hex="$1" r g b
    (( COLOR_OK )) || { printf ''; return; }
    if (( TRUECOLOR )); then
        read -r r g b <<< "$(hex_rgb "$hex")"
        printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
    else
        printf '\033[38;5;%dm' "$(hex256 "$hex")"
    fi
}

# same thing but background. used for the selected row and the footer bar
setbg() {
    local hex="$1" r g b
    (( COLOR_OK )) || { printf ''; return; }
    if (( TRUECOLOR )); then
        read -r r g b <<< "$(hex_rgb "$hex")"
        printf '\033[48;2;%d;%d;%dm' "$r" "$g" "$b"
    else
        printf '\033[48;5;%dm' "$(hex256 "$hex")"
    fi
}

