# ---------- string builders ----------
# ok this is the speed bit. every single $(fit ...) in the draw code forks a
# whole subshell, and one frame does like 90 of them, so a frame was taking
# 80ms. that is the entire reason the tui felt like it was walking through mud.
# these write into a variable with printf -v instead, so NO fork, and the same
# frame costs about 2ms. the old $() versions are kept as thin wrappers cuz the
# cli uses em once and its not worth changing every call site
strrep() {  # VAR char count
    local c="$1" n="$2" i out=""
    (( n < 0 )) && n=0
    for (( i = 0; i < n; i++ )); do out+="$c"; done
    printf -v "$3" '%s' "$out"
}

fitv() {  # VAR text width
    local s="$1" n="$2" pad
    (( n < 0 )) && n=0
    s="${s:0:n}"
    strrep ' ' $(( n - ${#s} )) pad
    printf -v "$3" '%s%s' "$s" "$pad"
}

barv() {  # VAR percent width
    local pct="$1" w="$2" i out="" filled
    (( pct > 100 )) && pct=100
    (( pct < 0 )) && pct=0
    filled=$(( pct * w / 100 ))
    for (( i = 0; i < w; i++ )); do
        if (( i < filled )); then out+="█"; else out+="░"; fi
    done
    printf -v "$3" '%s' "$out"
}

repeat() { strrep "$1" "$2" __s; printf '%s' "$__s"; }
fit() { fitv "$1" "$2" __f; printf '%s' "$__f"; }

# seconds -> 12:34, or 1:02:03 if you record long stuff. i aint judging
# (im judging a little bit)
timestr() {
    local s=${1:-0}
    (( s < 0 )) && s=0
    if (( s >= 3600 )); then
        printf '%d:%02d:%02d' $(( s / 3600 )) $(( (s % 3600) / 60 )) $(( s % 60 ))
    else
        printf '%d:%02d' $(( s / 60 )) $(( s % 60 ))
    fi
}

# turns "Desktop Audio (Realtek)" into desktop_audio_realtek_realtek so it
# dont blow up when it becomes a filename. spaces get turned into underscores
# cuz i refuse to put spaces in output filenames, theyre a pain in the shell
sanitize() {
    local s="$1"
    s="${s,,}"
    s="${s// /_}"
    s="${s//[^a-z0-9._-]/}"
    s="${s#_}"
    s="${s%_}"
    printf '%s' "$s"
}

# if the file already exists it tacks _1 _2 on the end instead of steamrolling
# your old take. i lost a good recording to a silent overwrite once and i still
# aint over it. never again
unique_path() {  # dir + base + ext
    local dir="$1" base="$2" ext="$3" p n=1
    p="$dir/$base.$ext"
    while [[ -e "$p" ]]; do
        p="$dir/${base}_$n.$ext"
        (( n++ ))
    done
    printf '%s' "$p"
}

# the track name. takes the title if the container has one, else falls back to
# desktop_audio / microphone cuz thats what obs calls em anyway. anything past
# that gets track_3, track_4 etc cuz i gave up on being clever
track_label() {  # pos + title + handler
    local pos="$1" name
    name=$(sanitize "${2:-${3:-}}")
    if [[ -n "$name" ]]; then
        printf '%s' "$name"
        return
    fi
    case "$pos" in
        0) printf 'desktop_audio' ;;
        1) printf 'microphone' ;;
        *) printf 'track_%d' $(( pos + 1 )) ;;
    esac
}

# one single value out of ffprobe. stderr goes to /dev/null cuz ffprobe loves
# to rant about metadata and i dont need to read it
ffprobe_value() {  # selector + entries + file
    local sel="$1" ents="$2" file="$3"
    ffprobe -v error -select_streams "$sel" -show_entries "$ents" \
        -of default=nw=1:nk=1 -- "$file" 2>/dev/null
}

# digs the track title out of the container and cleans it up. obs puts the
# real name in the track title so this is usually spot on
track_name_of() {  # input + position
    local input="$1" p="$2" meta k v title="" handler=""
    meta=$(ffprobe -v error -select_streams "a:$p" \
        -show_entries stream=stream_tags=title,handler_name \
        -of default=nw=1 -- "$input" 2>/dev/null)
    while IFS='=' read -r k v; do
        k="${k,,}"      # ffprobe yells in caps like it pays rent
        k="${k##*:}"    # chops tag:title down to just title. stupid but it works
        case "$k" in
            title) title="$v" ;;
            handler_name) handler="$v" ;;
        esac
    done <<< "$meta"
    track_label "$p" "$title" "$handler"
}

# one ffprobe call for the whole file. the old way ran a seperate ffprobe per
# track, so moving the selection spawned like 7 of them every single time and
# ffprobe dont exactly respond instantly on a 4gb recording. this parses the
# flat output in one read loop instead, so its 1 fork and a bit of bash
probe_all() {  # file
    R_DUR=0; R_VCODEC=""; R_ACOUNT=0
    R_NAME=(); R_CODEC=(); R_CH=()
    local line k v rest n f
    local -a TYPE=() CODEC=() CH=() TITLE=() HAND=()

    while IFS= read -r line; do
        k="${line%%=*}"; v="${line#*=}"
        v="${v#\"}"; v="${v%\"}"
        case "$k" in
            format_duration)
                v="${v%%.*}"
                [[ "$v" =~ ^[0-9]+$ ]] && R_DUR="$v"
                ;;
            streams_stream_*)
                rest="${k#streams_stream_}"
                n="${rest%%_*}"
                f="${rest#*_}"
                [[ "$n" =~ ^[0-9]+$ ]] || continue
                case "$f" in
                    codec_type)   TYPE[n]="$v" ;;
                    codec_name)   CODEC[n]="$v" ;;
                    channels)     CH[n]="$v" ;;
                    tags_title|tags_TITLE)               TITLE[n]="$v" ;;
                    tags_handler_name|tags_HANDLER_NAME) HAND[n]="$v" ;;
                esac
                ;;
        esac
    done < <(ffprobe -v error -show_entries \
        format=duration:stream=codec_type,codec_name,channels:stream_tags=title,handler_name \
        -of flat=s=_ -- "$1" 2>/dev/null)

    local i
    for i in "${!TYPE[@]}"; do
        if [[ "${TYPE[i]}" == "video" && -z "$R_VCODEC" ]]; then
            R_VCODEC="${CODEC[i]}"
        fi
    done
    for i in "${!TYPE[@]}"; do
        [[ "${TYPE[i]}" == "audio" ]] || continue
        R_NAME+=("$(track_label "$R_ACOUNT" "${TITLE[i]:-}" "${HAND[i]:-}")")
        R_CODEC+=("${CODEC[i]}")
        R_CH+=("${CH[i]}")
        (( R_ACOUNT++ ))
    done
}

# the blocky bar. full blocks for done, light shade for the rest
# na thats just my terminal font, its fine
# (thin wrapper over barv, see the string builders up top for why)
bar_of() {  # percent + width
    barv "$1" "$2" __b
    printf '%s' "$__b"
}

# cli version of the bar. \r so it redraws on the same line instead of
# scrolling 400 lines like a maniac
draw_bar() {
    local cur="$1" total="$2" label="$3" pct bar
    if (( total > 0 )); then pct=$(( cur * 100 / total )); else pct=0; fi
    bar=$(bar_of "$pct" 24)
    printf '\r  %s%s%s %3d%%  %s%s\033[K' "$B" "$bar" "$RST" "$pct" "$label" "$RST"
}

# =====================================================================
